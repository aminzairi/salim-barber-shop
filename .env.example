# ============================================================================
# Environment template — copy values into js/config.js for the BROWSER client
# (anon key only!) and into GitHub/Supabase secrets for server-side functions.
# NEVER commit real secrets. Service-role key lives ONLY in Supabase secrets.
# ----------------------------------------------------------------------------

# --- Frontend (js/config.js → SHOP.backend) — safe for the public browser ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase Edge Functions secrets (Dashboard → Edge Functions → Secrets) --
SUPABASE_SERVICE_ROLE_KEY=super-secret-never-in-frontend
WHATSAPP_TOKEN=            # Meta WhatsApp Cloud API permanent token (optional)
WHATSAPP_PHONE_ID=         # WhatsApp Business phone number id (optional)
OWNER_PHONE=+21622345678   # owner's WhatsApp for new-booking alerts
OWNER_EMAIL=owner@salimbarber.tn
RESEND_API_KEY=            # transactional email provider (optional)

# --- CI/CD (GitHub repo → Settings → Secrets and variables → Actions) --------
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
